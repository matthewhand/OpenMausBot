# Copy to deploy/.env and edit. deploy/.env is gitignored.

# Production compose (docker-compose.yml) needs a DNS name:
# DOMAIN=omb.example.com

# Dev compose (docker-compose.dev.yml) maps a host folder into the container.
# Default is the login home. Point this at a subfolder to sandbox the bots.
OMB_DEV_HOME=/home/matthewh
# OMB_DEV_HOME=/home/matthewh/projects/foo

# Container must share the host user's uid/gid so the bind mount is writable.
OMB_DEV_UID=1000
OMB_DEV_GID=1000

# Where OpenMausBot stores its own state inside the mapped folder.
OMB_DATA_SUBDIR=.openmausbot

# Harness listen (dev compose publishes this on the host). 8802 matches the
# Windows review UI. Do not use 8000 on ubuntu-max (LiteLLM).
OMB_HOST=0.0.0.0
OMB_PORT=8802

# Optional on a trusted LAN. Leave empty so the UI starts with no login.
# Set a token if this port is reachable beyond your home network.
OMB_AUTH_TOKEN=

OMB_CORS_ORIGIN=*

# Optional space-separated npm engine CLIs baked into the image.
# ENGINES=@anthropic-ai/claude-code
