# ==============================================================================
# OpenMausBot Environment Configuration Template
# ==============================================================================

# Server Network & Security
OMB_HOST=0.0.0.0
OMB_PORT=8800
OMB_AUTH_TOKEN=your-random-token-here
OMB_LAN_BYPASS_CIDR=10.0.0.0/24

# Text-to-Speech (TTS) Configuration
# Providers: elevenlabs | openai-compatible
OMB_TTS_PROVIDER=openai-compatible
OMB_TTS_BASE_URL=http://127.0.0.1:8000/v1
OMB_TTS_MODEL=tts-1
OMB_TTS_KEY=

# SaaS & Cloud Integrations (Optional)
# COMPOSIO_API_KEY=
# OPENCODE_API_KEY=
# XAI_API_KEY=
